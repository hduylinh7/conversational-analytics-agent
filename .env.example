# Application Settings
APP_NAME=Conversational Analytics Agent
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# LangGraph Orchestration
GRAPH_RECURSION_LIMIT=50

# LangGraph Checkpointing ('memory' | 'redis').
# 'redis' enables persistent multi-turn conversations; docker-compose defaults to 'redis'.
CHECKPOINTER_BACKEND=memory

# SSE Streaming keep-alive interval (seconds) for /analyze/stream
SSE_HEARTBEAT_INTERVAL_SECONDS=15

# SQL Self-Repair Budgets (guardrail and execution loops)
SQL_MAX_REPAIR_ATTEMPTS=3
SQL_MAX_EXECUTION_REPAIR_ATTEMPTS=2

# Streamlit Demo UI (frontend/streamlit)
STREAMLIT_BACKEND_URL=http://localhost:8000
STREAMLIT_TIMEOUT_SECONDS=120
STREAMLIT_LOG_LEVEL=INFO
