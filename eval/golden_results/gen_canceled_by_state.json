{
  "caseId": "gen_canceled_by_state",
  "goldenSql": "SELECT\n  c.customer_state,\n  COUNT(DISTINCT o.order_id) AS canceled_order_count\nFROM business.orders AS o\nJOIN business.customers AS c\n  ON c.customer_id = o.customer_id\nWHERE\n  o.order_status = 'canceled'\nGROUP BY\n  c.customer_state\nLIMIT 100",
